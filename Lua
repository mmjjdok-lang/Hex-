----------------------------------------------------------------- helpers
local function new(c,p)
	local o=Instance.new(c)
	for k,v in pairs(p or {}) do o[k]=v end
	return o
end
local function tw(o,t,p,style,dir)
	local x=TS:Create(o,TweenInfo.new(t,style or Enum.EasingStyle.Quint,dir or Enum.EasingDirection.Out),p)
	x:Play() return x
end
local function corner(o,r) return new("UICorner",{CornerRadius=UDim.new(0,r),Parent=o}) end
local function stroke(o,c,t,tr) return new("UIStroke",{Color=c,Thickness=t or 1,Transparency=tr or 0,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=o}) end
local function txt(p,t,s,f,c,xa)
	return new("TextLabel",{BackgroundTransparency=1,Text=t,TextSize=s or 13,Font=f or G,TextColor3=c or TXT,TextXAlignment=xa or LEFT,Parent=p})
end
local function safe(f,...)
	if type(f)=="function" then
		local ok,e=pcall(f,...)
		if not ok then warn("[HE] "..tostring(e)) end
	end
end
local function hex(c) return string.format("#%02X%02X%02X",math.floor(c.R*255+.5),math.floor(c.G*255+.5),math.floor(c.B*255+.5)) end

local sound=new("Sound",{SoundId="rbxassetid://3868133279",Volume=.6,Parent=SS})
local function click() sound.TimePosition=0 sound:Play() end

-- water-drop ripple at the pressed point
local function ripple(host,x,y)
	host.ClipsDescendants=true
	local ap,as=host.AbsolutePosition,host.AbsoluteSize
	local m=math.max(as.X,as.Y)*2
	local c=new("Frame",{BackgroundColor3=WHITE,BackgroundTransparency=.75,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(x-ap.X,y-ap.Y),Size=UDim2.fromOffset(0,0),ZIndex=host.ZIndex+20,Parent=host})
	corner(c,999)
	local s=stroke(c,WHITE,2,.4)
	tw(c,.65,{Size=UDim2.fromOffset(m,m),BackgroundTransparency=1})
	tw(s,.65,{Transparency=1})
	task.delay(.7,function() c:Destroy() end)
end
local function isPress(i) return i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch end
local function interactive(btn,host)
	btn.AutoButtonColor=false
	btn.InputBegan:Connect(function(i)
		if isPress(i) then ripple(host or btn,i.Position.X,i.Position.Y) click() end
	end)
end

-- icons (asset id, rbxassetid, or name from the Icons library)
local IconsLib
local function loadIcons()
	local ok,r=pcall(function() return loadstring(game:HttpGet(ICONS_URL))() end)
	if ok then IconsLib=r end
end
local function assetUrl(v)
	v=tostring(v)
	if tonumber(v) then return "rbxassetid://"..v end
	return v
end
local function setIcon(img,icon)
	if not icon or icon=="" then return false end
	if tonumber(icon) or tostring(icon):find("rbx") or tostring(icon):find("http") then img.Image=assetUrl(icon) return true end
	if IconsLib then
		local ok,r=pcall(function()
			if type(IconsLib.Icon)=="function" then return IconsLib.Icon(icon) end
			return IconsLib[icon]
		end)
		if ok and r then
			if type(r)=="string" then img.Image=assetUrl(r) return true end
			if type(r)=="table" then
				local id=r.Image or r[1]
				local rect=type(r[2])=="table" and r[2] or r
				if id then
					img.Image=assetUrl(id)
					if rect.ImageRectSize then img.ImageRectSize=rect.ImageRectSize end
					if rect.ImageRectPosition then img.ImageRectOffset=rect.ImageRectPosition end
					return true
				end
			end
		end
	end
	return false
end

local function guiParent()
	local ok,h=pcall(function() return gethui and gethui() end)
	if ok and h then return h end
	local ok2=pcall(function() return game:GetService("CoreGui"):GetChildren() end)
	if ok2 then return game:GetService("CoreGui") end
