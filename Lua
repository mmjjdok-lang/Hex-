-- Selects a sidebar tab with animations: indicator, pulse, color change, page slide
function Window:SelectTab(tab)
	self.CurrentTab = tab
	for _, t in ipairs(self.Tabs) do
		local on = t == tab
		Tween(t.Button, 0.25, { BackgroundTransparency = on and 0.86 or 1 })
		Tween(t.Label, 0.25, { TextColor3 = on and WHITE or GRAY })
		Tween(t.Indicator, 0.35, { Size = on and UDim2.fromOffset(3, 16) or UDim2.fromOffset(3, 0) }, Enum.EasingStyle.Back)
		if on then
			t.ButtonScale.Scale = 0.92
			Tween(t.ButtonScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		end
		RefreshTab(t, on)
	end
end

