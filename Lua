--// Icon database (names -> asset ids)
local IconDB = {}
do
	local ok, res = pcall(function()
		return loadstring(game:HttpGet(ICONS_URL))()
	end)
	if ok and type(res) == "table" then
		IconDB = res
	end
end

local function FindIcon(name, tbl, depth)
	depth = depth or 0
	if depth > 4 then
		return nil
	end
	if tbl[name] ~= nil then
		return tbl[name]
	end
	for _, v in pairs(tbl) do
		if type(v) == "table" then
			local r = FindIcon(name, v, depth + 1)
			if r ~= nil then
				return r
			end
		end
	end
	return nil
end

local function NormalizeImage(v)
	if type(v) == "table" then
		v = v.Image or v.image or v.Icon or v.icon or v.id or v[1]
	end
	if type(v) == "number" then
		return "rbxassetid://" .. v
	elseif type(v) == "string" then
		if v:match("^%d+$") then
			return "rbxassetid://" .. v
		end
		return v
	end
	return nil
end

-- Accepts an asset id, a full rbxassetid/url, or an icon name from the icons site
local function ResolveIcon(value)
	if value == nil or value == "" then
		return nil
	end
	if type(value) == "number" then
		return NormalizeImage(value)
	end
	if type(value) == "string" then
		if value:match("^%d+$") or value:find("rbxassetid") or value:find("^http") then
			return NormalizeImage(value)
		end
		return NormalizeImage(FindIcon(value, IconDB))
	end
	return nil
end

local function ResolveColor(value)
	if typeof(value) == "Color3" then
		return value
	elseif type(value) == "string" and PALETTE[value] then
		return PALETTE[value]
	end
	return nil
end

--// Helpers
local function Create(class, props)
	local inst = Instance.new(class)
	local parent = props and props.Parent
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	inst.Parent = parent
	return inst
end

local function Corner(parent, radius)
	return Create("UICorner", { CornerRadius = UDim.new(0, radius or RADIUS), Parent = parent })
end

local function Stroke(parent, transparency, thickness, color)
	return Create("UIStroke", {
		Color = color or WHITE,
		Transparency = transparency or 0.75,
		Thickness = thickness or 1,
		Parent = parent,
	})
end

local function Tween(obj, time, goal, style, direction)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
		goal
	)
	t:Play()
	return t
end

local function IsPress(input)
	return input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1
end

local function PlayClick()
	local s = Create("Sound", { SoundId = CLICK_SOUND_ID, Volume = 0.5, Parent = SoundService })
	s:Play()
	Debris:AddItem(s, 3)
end

-- Water ripple at the touch point
local function Ripple(obj, input)
	local rel = Vector2.new(input.Position.X, input.Position.Y) - obj.AbsolutePosition
	local d = math.max(obj.AbsoluteSize.X, obj.AbsoluteSize.Y) * 2
	local circle = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(rel.X, rel.Y),
		Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = obj.ZIndex + 1,
		Parent = obj,
	})
	Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = circle })
	local t = Tween(circle, 0.6, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 })
	t.Completed:Connect(function()
		circle:Destroy()
	end)
end

-- Ripple + click sound + callback
local function BindPress(button, onPress)
	button.InputBegan:Connect(function(input)
		if IsPress(input) then
			Ripple(button, input)
		end
	end)
	button.Activated:Connect(function()
		PlayClick()
		if onPress then
			onPress()
		end
	end)
end

-- Row text: title (+ optional description). top = force top alignment
local function RowText(row, name, desc, rightPad, top)
	rightPad = rightPad or 12
	local hasDesc = desc ~= nil and desc ~= ""
	local useTop = hasDesc or top == true
	local title = Create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, useTop and 8 or 0),
		Size = useTop and UDim2.new(1, -(12 + rightPad), 0, 18) or UDim2.new(1, -(12 + rightPad), 1, 0),
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = name or "",
		ZIndex = 2,
		Parent = row,
	})
	local descLabel
	if hasDesc then
		descLabel = Create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 26),
			Size = UDim2.new(1, -(12 + rightPad), 0, 14),
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextColor3 = GRAY,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = desc,
			ZIndex = 2,
			Parent = row,
		})
	end
	return title, descLabel
end

-- Shows/hides the page of a tab (slide-in animation on show)
local function RefreshTab(t, on)
	t.Header.Visible = on
	local pages = { t }
	for _, s in ipairs(t.Subs) do
		table.insert(pages, s)
	end
	for _, p in ipairs(pages) do
		local show = on and p == t.ActivePage
		if show then
			if not p.Scroll.Visible then
				p.Scroll.Visible = true
				p.Scroll.Position = UDim2.fromOffset(24, CONTENT_TOP)
				Tween(p.Scroll, 0.3, { Position = UDim2.fromOffset(0, CONTENT_TOP) })
			end
		else
			p.Scroll.Visible = false
		end
	end
end

-- Skin helpers (module level)
local function ApplyTrails(model)
	local made = {}
	if not model then
		return made
	end
	for _, name in ipairs(TRAIL_JOINTS) do
		local part = model:FindFirstChild(name, true)
		if part and part:IsA("BasePart") then
			local a0 = Create("Attachment", { Position = Vector3.new(0, -0.45, 0), Parent = part })
			local a1 = Create("Attachment", { Position = Vector3.new(0, 0.45, 0), Parent = part })
			local trail = Create("Trail", {
				Attachment0 = a0,
				Attachment1 = a1,
				Color = ColorSequence.new(PURPLE),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.1),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Lifetime = 0.7,
				MinLength = 0.02,
				LightEmission = 0.5,
				FaceCamera = true,
				Parent = part,
			})
			table.insert(made, a0)
			table.insert(made, a1)
			table.insert(made, trail)
		end
	end
	return made
end

local function ApplyEffect(model, name)
	if not model or name == "None" then
		return nil
	end
	if name == "Headless" then
		local head = model:FindFirstChild("Head")
		if head then
			head.Transparency = 1
			for _, d in ipairs(head:GetChildren()) do
				if d:IsA("Decal") then
					d.Transparency = 1
				end
			end
		end
	elseif name == "Korblox" then
		for _, n in ipairs({ "RightUpperLeg", "RightLowerLeg", "RightFoot" }) do
			local p = model:FindFirstChild(n)
			if p and p:IsA("BasePart") then
				p.Color = Color3.fromRGB(35, 150, 60)
				p.Material = Enum.Material.Neon
			end
		end
	elseif name == "Rainbow" then
		return RunService.Heartbeat:Connect(function()
			local c = Color3.fromHSV((tick() * 0.25) % 1, 1, 1)
			for _, p in ipairs(model:GetDescendants()) do
				if p:IsA("BasePart") then
					p.Color = c
				end
			end
		end)
	elseif name == "Fire" then
		local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart")
		if torso then
			Create("ParticleEmitter", {
				Texture = "rbxasset://textures/particles/fire_main.dds",
				Rate = 60,
				Lifetime = NumberRange.new(0.6, 1.2),
				Speed = NumberRange.new(2, 4),
				SpreadAngle = Vector2.new(20, 20),
				Size = NumberSequence.new(1.2, 0.1),
				Color = ColorSequence.new(Color3.fromRGB(255, 180, 40), Color3.fromRGB(255, 60, 20)),
				LightEmission = 0.8,
				Parent = torso,
			})
		end
	end
	return nil
end

--// Page (shared by tabs, sub-tabs, boxes and settings pages)
local Page = {}
Page.__index = Page

local function CountGuiChildren(frame)
	local n = 0
	for _, ch in ipairs(frame:GetChildren()) do
		if ch:IsA("GuiObject") then
			n += 1
		end
	end
	return n
end

function Page:_Init(scroll, window)
	self.Scroll = scroll
	self.Window = window
	self.Elements = {}
	self.Columns = {}
	self.ColumnCount = 1
	self.Order = 0

	self.Holder = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = scroll,
	})
	Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, GAP),
		Parent = self.Holder,
	})
	self:_BuildColumns()
end

function Page:_BuildColumns()
	for _, col in ipairs(self.Columns) do
		col:Destroy()
	end
	self.Columns = {}
	local n = self.ColumnCount
	for i = 1, n do
		local col = Create("Frame", {
			Size = UDim2.new(1 / n, -math.ceil((n - 1) * GAP / n), 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = i,
			Parent = self.Holder,
		})
		Create("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = col,
		})
		table.insert(self.Columns, col)
	end
	for _, root in ipairs(self.Elements) do
		self:_PlaceInShortest(root)
	end
end

function Page:_PlaceInShortest(root)
	local best, bestCount = nil, math.huge
	for _, col in ipairs(self.Columns) do
		local count = CountGuiChildren(col)
		if count < bestCount then
			best, bestCount = col, count
		end
	end
	root.Parent = best
end

-- 1 to 3 columns (anything above 3 becomes 3)
function Page:SetColumns(n)
	n = math.clamp(math.floor(tonumber(n) or 1), 1, 3)
	self.ColumnCount = n
	for _, root in ipairs(self.Elements) do
		root.Parent = nil
	end
	self:_BuildColumns()
end

function Page:_NextOrder()
	self.Order += 1
	return self.Order
end

function Page:_Row(height)
	local row = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = ROW_BG,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = self:_NextOrder(),
	})
	Corner(row)
	Stroke(row, 0.8)
	table.insert(self.Elements, row)
	self:_PlaceInShortest(row)
	return row
end

-- Button: name, description, callback
function Page:AddButton(cfg)
	cfg = cfg or {}
	local row = self:_Row(50)
	local title = RowText(row, cfg.Name or "Button", cfg.Description, 12)
	BindPress(row, function()
		if cfg.Callback then
			task.spawn(cfg.Callback)
		end
	end)
	local obj = {}
	function obj:SetName(text)
		title.Text = text
	end
	return obj
end

-- Toggle: small rectangle with a square knob that slides left/right
function Page:AddToggle(cfg)
	cfg = cfg or {}
	local state = cfg.Default == true
	local row = self:_Row(50)
	RowText(row, cfg.Name or "Toggle", cfg.Description, 60)

	local track = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(36, 18),
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = row,
	})
	Stroke(track, 0, 1)
	Create("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(45, 45, 45), BLACK),
		Rotation = 90,
		Parent = track,
	})
	local knob = Create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = track,
	})

	local function SetState(v, silent)
		state = v and true or false
		Tween(knob, 0.25, {
			Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
		})
		if not silent and cfg.Callback then
			task.spawn(cfg.Callback, state)
		end
	end

	BindPress(row, function()
		SetState(not state)
	end)

	local obj = {}
	function obj:Set(v, silent)
		SetState(v, silent)
	end
	function obj:Get()
		return state
	end
	return obj
end

-- Slider: drag with one finger/mouse
function Page:AddSlider(cfg)
	cfg = cfg or {}
	local min, max = cfg.Min or 0, cfg.Max or 100
	local inc = cfg.Increment or 1
	local value = math.clamp(cfg.Default or min, min, max)
	local row = self:_Row(56)
	RowText(row, cfg.Name or "Slider", nil, 60, true)

	local valueLabel = Create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 8),
		Size = UDim2.fromOffset(60, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = GRAY,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = tostring(value),
		ZIndex = 2,
		Parent = row,
	})
	local track = Create("Frame", {
		Position = UDim2.fromOffset(12, 38),
		Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = row,
	})
	Stroke(track, 0.5, 1)
	local fill = Create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = track,
	})
	local hit = Create("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 22),
		ZIndex = 4,
		Parent = row,
	})

	local function Render(v)
		fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
		valueLabel.Text = tostring(v)
	end

	local function SetValue(v, fire)
		local snapped = math.floor((v - min) / inc + 0.5) * inc + min
		value = math.clamp(snapped, min, max)
		Render(value)
		if fire and cfg.Callback then
			task.spawn(cfg.Callback, value)
		end
	end
	Render(value)

	local dragging = nil
	local function FromInput(input)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local a = math.clamp((input.Position.X - track.AbsolutePosition.X) / width, 0, 1)
		SetValue(min + a * (max - min), true)
	end

	hit.InputBegan:Connect(function(input)
		if dragging or not IsPress(input) then
			return
		end
		dragging = input
		FromInput(input)
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input == dragging or (dragging.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then
			FromInput(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input == dragging or (dragging.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			dragging = nil
		end
	end)

	local obj = {}
	function obj:Set(v)
		SetValue(v, false)
	end
	function obj:Get()
		return value
	end
	return obj
end

