----------------------------------------------------------------- skin effects
local function eachPart(ch,f)
	for _,d in ipairs(ch:GetDescendants()) do
		if d:IsA("BasePart") and d.Name~="HumanoidRootPart" then f(d) end
	end
end
local function clearFX(ch,name)
	for _,d in ipairs(ch:GetDescendants()) do if d.Name=="HE_FX_"..name then d:Destroy() end end
end
local function torso(ch) return ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") or ch:FindFirstChild("HumanoidRootPart") end
local function setT(ch,st,v)
	st.t=st.t or {}
	eachPart(ch,function(p) if st.t[p]==nil then st.t[p]=p.Transparency end p.Transparency=v end)
end
local function resetT(st) for p,v in pairs(st.t or {}) do if p.Parent then p.Transparency=v end end st.t=nil end
local function emitter(class,props)
	return function(ch,st,name)
		local t=torso(ch)
		if t then props.Name="HE_FX_"..name props.Parent=t new(class,props) end
	end
end
local FXList={"Headless","Korblox","Rainbow","Fire","Purple Trails","Neon Glow","Ghost","Sparkles","Smoke","Invisible"}
local FX={
	Headless={on=function(ch,st)
		local h=ch:FindFirstChild("Head")
		if h then st.o=h.Transparency h.Transparency=1 for _,d in ipairs(h:GetChildren()) do if d:IsA("Decal") then d.Transparency=1 end end end
	end,off=function(ch,st)
		local h=ch:FindFirstChild("Head")
		if h then h.Transparency=st.o or 0 for _,d in ipairs(h:GetChildren()) do if d:IsA("Decal") then d.Transparency=0 end end end
	end},
	Korblox={on=function(ch,st)
		local hum=ch:FindFirstChildOfClass("Humanoid")
		local d=hum:GetAppliedDescription()
		st.d=d:Clone() d.RightLeg=139607718
		hum:ApplyDescription(d)
	end,off=function(ch,st)
		local hum=ch:FindFirstChildOfClass("Humanoid")
		if st.d and hum then hum:ApplyDescription(st.d) end
	end},
	Rainbow={on=function(ch,st)
		st.o={}
		eachPart(ch,function(p) st.o[p]=p.Color end)
		st.c=RS.Heartbeat:Connect(function()
			local col=Color3.fromHSV((tick()*.4)%1,1,1)
			for p in pairs(st.o) do if p.Parent then p.Color=col end end
		end)
	end,off=function(ch,st)
		if st.c then st.c:Disconnect() end
		for p,c in pairs(st.o or {}) do if p.Parent then p.Color=c end end
	end},
	Fire={on=function(ch,st) for _,n in ipairs({"UpperTorso","Torso","RightHand","LeftHand","Right Arm","Left Arm"}) do
		local p=ch:FindFirstChild(n)
		if p then new("Fire",{Name="HE_FX_Fire",Size=n:find("Torso") and 7 or 4,Heat=8,Parent=p}) end
	end end},
	["Purple Trails"]={on=function(ch)
		local names={"RightUpperArm","LeftUpperArm","RightHand","LeftHand","RightUpperLeg","LeftUpperLeg","Right Arm","Left Arm","Right Leg","Left Leg"}
		for _,n in ipairs(names) do
			local p=ch:FindFirstChild(n)
			if p then
				local y=0
				if n:find("UpperArm") or n:find("Arm") then y=p.Size.Y/2 elseif n:find("Leg") then y=-p.Size.Y/2 end
				local a0=new("Attachment",{Name="HE_FX_Purple Trails",Position=Vector3.new(-.25,y,0),Parent=p})
				local a1=new("Attachment",{Name="HE_FX_Purple Trails",Position=Vector3.new(.25,y,0),Parent=p})
				new("Trail",{Name="HE_FX_Purple Trails",Attachment0=a0,Attachment1=a1,Color=ColorSequence.new(Color3.fromRGB(165,70,255),Color3.fromRGB(80,20,180)),Transparency=NumberSequence.new(.1,1),Lifetime=.7,LightEmission=1,MinLength=.02,FaceCamera=true,Parent=p})
			end
		end
	end},
	["Neon Glow"]={on=function(ch,st)
		st.m={}
		eachPart(ch,function(p) st.m[p]=p.Material p.Material=Enum.Material.Neon end)
		local t=torso(ch)
		if t then new("PointLight",{Name="HE_FX_Neon Glow",Range=14,Brightness=2,Color=Color3.fromRGB(160,80,255),Parent=t}) end
	end,off=function(ch,st) for p,m in pairs(st.m or {}) do if p.Parent then p.Material=m end end end},
	Ghost={on=function(ch,st) setT(ch,st,.6) end,off=function(ch,st) resetT(st) end},
	Sparkles={on=function(ch,st) emitter("Sparkles",{SparkleColor=Color3.fromRGB(255,215,120)})(ch,st,"Sparkles") end},
	Smoke={on=function(ch,st) emitter("Smoke",{Color=Color3.fromRGB(90,90,90),Size=6,Opacity=.4})(ch,st,"Smoke") end},
	Invisible={on=function(ch,st) setT(ch,st,1) end,off=function(ch,st) resetT(st) end},
}

