			ImageColor3 = WHITE,
			ZIndex = 52,
			Parent = searchRow,
		})
		searchBox = Create("TextBox", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(30, 0),
			Size = UDim2.new(1, -36, 1, 0),
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = WHITE,
			PlaceholderText = "Search",
			PlaceholderColor3 = GRAY,
			Text = "",
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			ZIndex = 52,
			Parent = searchRow,
		})
	end

	local optionScroll = Create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, topOffset),
		Size = UDim2.new(1, 0, 1, -topOffset),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = WHITE,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 51,
		Parent = list,
	})
	Create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = optionScroll })
	Create("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = optionScroll })

	local open = false
	local optionButtons = {}

	local function SetSelected(name, fire)
		selected = name
		btnText.Text = name
		if fire and cfg.Callback then
			task.spawn(cfg.Callback, name)
		end
	end

	local function Close()
		open = false
		local t = Tween(list, 0.2, { Size = UDim2.fromOffset(list.Size.X.Offset, 0) })
		t.Completed:Connect(function()
			if not open then
				list.Visible = false
			end
		end)
	end

	local function Open()
		open = true
		local rel = btn.AbsolutePosition - window.Frame.AbsolutePosition
		local w = btn.AbsoluteSize.X
		local h = math.min(#items * 28 + topOffset, 190) + 4
		list.Size = UDim2.fromOffset(w, 0)
		list.Position = UDim2.fromOffset(rel.X, rel.Y - 4)
		list.Visible = true
		Tween(list, 0.25, { Size = UDim2.fromOffset(w, h) })
	end

	for _, it in ipairs(items) do
		local ob = Create("TextButton", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = #optionButtons + 1,
			ZIndex = 52,
			Parent = optionScroll,
		})
		local iconImg = ResolveIcon(it.Icon)
		local textX = 8
		if iconImg then
			Create("ImageLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(6, 5),
				Size = UDim2.fromOffset(16, 16),
				Image = iconImg,
				ImageColor3 = WHITE,
				ZIndex = 53,
				Parent = ob,
			})
			textX = 28
		end
		Create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(textX, 0),
			Size = UDim2.new(1, -(textX + 6), 1, 0),
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = WHITE,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = it.Name,
			ZIndex = 53,
			Parent = ob,
		})
		BindPress(ob, function()
			if cfg.ButtonMode then
				if it.Callback then
					task.spawn(it.Callback)
				end
			else
				SetSelected(it.Name, true)
			end
			Close()
		end)
		table.insert(optionButtons, { Button = ob, Name = it.Name })
	end

	if searchBox then
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			local q = searchBox.Text:lower()
			for _, ob in ipairs(optionButtons) do
				ob.Button.Visible = q == "" or ob.Name:lower():find(q, 1, true) ~= nil
			end
		end)
	end

	BindPress(btn, function()
		if open then
			Close()
		else
			Open()
		end
	end)

	if cfg.ButtonMode then
		btnText.Text = cfg.Label or "Actions"
	else
		SetSelected(selected, false)
	end

	local obj = {}
	function obj:Set(name, silent)
		SetSelected(name, not silent)
	end
	function obj:Get()
		return selected
	end
	return obj
end

