----------------------------------------------------------------- skin system
function Window:Skin(o)
	o=o or {}
	local accent=self.Accent
	local tab=self:_makeTab(self.TabList,o.TabName or "Skin",o.Icon or "user",0)
	local pg=tab.Page
	local card=pg:_card(230)
	local vp=new("ViewportFrame",{Position=UDim2.fromOffset(12,12),Size=UDim2.fromOffset(190,206),BackgroundColor3=Color3.fromRGB(8,8,10),Ambient=Color3.fromRGB(190,190,190),LightColor=WHITE,Parent=card})
	corner(vp,8) stroke(vp,LINE,1)
	local cam=new("Camera",{FieldOfView=35,Parent=vp}) vp.CurrentCamera=cam
	local wm=new("WorldModel",{Parent=vp})
	local mdl,angle,dragging=nil,0,false
	local function setModel(desc)
		if mdl then mdl:Destroy() mdl=nil end
		local ok,m=pcall(function() return Players:CreateHumanoidModelFromDescription(desc,Enum.HumanoidRigType.R15) end)
		if not ok or not m then return false end
		m.Parent=wm mdl=m
		local hrp=m:FindFirstChild("HumanoidRootPart")
		if hrp then hrp.Anchored=true end
		m:PivotTo(CFrame.new(0,0,0))
		local cf,size=m:GetBoundingBox()
		local dist=size.Y/(2*math.tan(math.rad(17.5)))*1.15+size.Z
		cam.CFrame=CFrame.new(cf.Position+Vector3.new(0,0,dist),cf.Position)
		return true
	end
	table.insert(self.Conns,RS.RenderStepped:Connect(function(dt)
		if mdl and mdl.Parent then
			if not dragging then angle=angle+dt*.6 end
			mdl:PivotTo(CFrame.Angles(0,angle,0))
		end
	end))
	do -- 360 rotation by dragging the preview
		local cur,last
		vp.InputBegan:Connect(function(i)
			if cur or not isPress(i) then return end
			cur=i last=i.Position dragging=true pg.Scroll.ScrollingEnabled=false
			i.Changed:Connect(function()
				if i.UserInputState==Enum.UserInputState.End then cur=nil dragging=false pg.Scroll.ScrollingEnabled=true end
			end)
		end)
		table.insert(self.Conns,UIS.InputChanged:Connect(function(i)
			if cur and (i==cur or (cur.UserInputType==Enum.UserInputType.MouseButton1 and i.UserInputType==Enum.UserInputType.MouseMovement)) then
				angle=angle+(i.Position.X-last.X)*.015 last=i.Position
			end
		end))
	end
	local t=txt(card,"Player Name",12,GB) t.Position=UDim2.fromOffset(214,12) t.Size=UDim2.new(1,-226,0,18)
	local box=new("TextBox",{Position=UDim2.fromOffset(214,34),Size=UDim2.new(1,-226,0,30),BackgroundColor3=Color3.fromRGB(10,10,12),Text="",PlaceholderText="Enter username",PlaceholderColor3=SUB,TextColor3=TXT,Font=G,TextSize=12,ClearTextOnFocus=false,Parent=card})
	corner(box,6) stroke(box,LINE,1)
	local ap=new("TextButton",{Position=UDim2.fromOffset(214,72),Size=UDim2.new(1,-226,0,32),BackgroundColor3=accent,Text="Apply Skin",TextColor3=WHITE,Font=GB,TextSize=12,AutoButtonColor=false,Parent=card})
	corner(ap,6) interactive(ap,ap)
	local status=txt(card,"Drag the preview to rotate 360 degrees.",11,G,SUB) status.Position=UDim2.fromOffset(214,112) status.Size=UDim2.new(1,-226,0,60) status.TextWrapped=true status.TextYAlignment=Enum.TextYAlignment.Top

	-- effects
	local n=math.clamp(o.Effects or #FXList,1,#FXList)
	local names={}
	for i=1,n do names[i]=FXList[i] end
	local active,stores={},{}
	local function applyFX(name,on)
		local ch=LP.Character
		if not ch then return end
		local fx=FX[name]
		if on then
			clearFX(ch,name)
			stores[name]={}
			local ok,e=pcall(fx.on,ch,stores[name],name)
			if not ok then warn("[HE] effect "..name..": "..tostring(e)) end
		else
			pcall(function() if fx.off then fx.off(ch,stores[name] or {}) end end)
			clearFX(ch,name) stores[name]=nil
		end
	end
	pg:Dropdown({Name="Player Effects",Options=names,Multi=true,Callback=function(list)
		local set={}
		for _,nm in ipairs(list) do set[nm]=true end
		for _,nm in ipairs(names) do
			if set[nm] and not active[nm] then active[nm]=true applyFX(nm,true)
			elseif not set[nm] and active[nm] then active[nm]=nil applyFX(nm,false) end
		end
	end})
	table.insert(self.Conns,LP.CharacterAdded:Connect(function()
		task.wait(1.5)
		for nm in pairs(active) do applyFX(nm,true) end
	end))

	-- categories
	local cc=pg:_card(60)
	local cl=txt(cc,"",12,G,SUB) cl.RichText=true cl.TextWrapped=true cl.TextYAlignment=Enum.TextYAlignment.Top
	cl.Position=UDim2.fromOffset(12,10) cl.Size=UDim2.new(1,-24,0,0) cl.AutomaticSize=Enum.AutomaticSize.Y
	cl:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() cc.Size=UDim2.new(1,0,0,cl.AbsoluteSize.Y+20) end)
	local hx=hex(accent)
	local function describe(d)
		local function v(x) return (x and x~=0 and x~="") and tostring(x) or "Default" end
		local function cnt(s) if not s or s=="" then return "None" end local c=0 for _ in tostring(s):gmatch("%d+") do c=c+1 end return c==0 and "None" or tostring(c) end
		local jackets=0
		pcall(function() for _,a in ipairs(d:GetAccessories(true)) do local nm=tostring(a.AccessoryType) if nm:find("Jacket") or nm:find("Sweater") then jackets=jackets+1 end end end)
		local function h(s) return '<font color="'..hx..'"><b>'..s..'</b></font>\n' end
		cl.Text=h("1. Body Parts")..
			"Head: "..v(d.Head).."\nTorso: "..v(d.Torso).."\nLeft Arm: "..v(d.LeftArm).."\nRight Arm: "..v(d.RightArm).."\nLeft Leg: "..v(d.LeftLeg).."\nRight Leg: "..v(d.RightLeg).."\n\n"..
			h("2. Clothing")..
			"Shirts: "..v(d.Shirt).."\nPants: "..v(d.Pants).."\nClassic T-Shirts: "..v(d.GraphicTShirt).."\nSweaters / Jackets: "..jackets.."\n\n"..
			h("3. Accessories & Appearance")..
			"Hair: "..cnt(d.HairAccessory).."\nFace: "..v(d.Face).."\nNeck: "..cnt(d.NeckAccessory).."\nShoulders: "..cnt(d.ShouldersAccessory).."\nFront: "..cnt(d.FrontAccessory).."\nBack: "..cnt(d.BackAccessory).."\nWaist: "..cnt(d.WaistAccessory).."\nFace Accessories: "..cnt(d.FaceAccessory).."\nHead Accessories: "..cnt(d.HatAccessory)
	end

	local busy=false
	local function load(name)
		if busy then return end
		busy=true status.Text="Loading skin..." status.TextColor3=SUB
		local ok,err=pcall(function()
			local uid=(name==nil or name=="") and LP.UserId or Players:GetUserIdFromNameAsync(name)
			local desc=Players:GetHumanoidDescriptionFromUserId(uid)
			setModel(desc) describe(desc)
			if name and name~="" then
				local ch=LP.Character
				local hum=ch and ch:FindFirstChildOfClass("Humanoid")
				if hum then hum:ApplyDescription(desc) end
			end
		end)
		if ok then
			status.Text=(name and name~="") and ("Skin applied: "..name) or "Showing your skin."
			status.TextColor3=TXT
			for nm in pairs(active) do applyFX(nm,true) end
		else
			status.Text="Could not load that player." status.TextColor3=Color3.fromRGB(240,90,90)
			warn("[HE] skin: "..tostring(err))
		end
		busy=false
	end
	ap.Activated:Connect(function() load(box.Text) end)
	task.spawn(load,nil)
	return pg
end

----------------------------------------------------------------- window
function Window:SetVisible(v)
	self.Visible=v
	if v then
		self.Root.Visible=true
		if self.OpenBtn then self.OpenBtn.Visible=false end
		tw(self.RootScale,.35,{Scale=1},Enum.EasingStyle.Back)
	else
		tw(self.RootScale,.25,{Scale=.01})
		task.delay(.27,function()
			if not self.Visible then
				self.Root.Visible=false
				if self.OpenBtn then self.OpenBtn.Visible=true end
			end
		end)
	end
end

function Window:Destroy()
	for _,c in ipairs(self.Conns) do pcall(function() c:Disconnect() end) end
	if self.OnDestroy then safe(self.OnDestroy) end
	self.Gui:Destroy()
end

function Window:ToggleHalf()
	self.Half=not self.Half
	local full=self.FullSize
	if self.Half then
		self.Title.TextXAlignment=CENTER
		tw(self.Title,.35,{Position=UDim2.new(0,100,0,0),Size=UDim2.new(1,-200,0,41)})
		tw(self.Sub,.2,{TextTransparency=1}) tw(self.HIcon,.2,{ImageTransparency=1})
		tw(self.Root,.35,{Size=UDim2.new(full.X.Scale,full.X.Offset,0,42)},Enum.EasingStyle.Quint)
		task.delay(.3,function() if self.Half then self.Sidebar.Visible=false self.Content.Visible=false end end)
	else
		self.Sidebar.Visible=true self.Content.Visible=true
		self.Title.TextXAlignment=LEFT
		tw(self.Title,.35,{Position=UDim2.new(0,self.TitleX,0,3),Size=UDim2.new(1,-190,0,22)})
		tw(self.Sub,.3,{TextTransparency=0}) tw(self.HIcon,.3,{ImageTransparency=0})
		tw(self.Root,.4,{Size=full},Enum.EasingStyle.Back)
	end
end

function Window:_confirm()
	local main=self.Main
	local ov=new("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=1,Text="",ZIndex=100,Parent=main})
	tw(ov,.25,{BackgroundTransparency=.4})
	local d=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(290,128),BackgroundColor3=Color3.new(0,0,0),Parent=ov})
	corner(d,10) stroke(d,self.Accent,1.5,.2)
	local sc=new("UIScale",{Scale=.7,Parent=d}) tw(sc,.3,{Scale=1},Enum.EasingStyle.Back)
	local t=txt(d,"Are you sure you want to delete the script?",14,GB,TXT,CENTER) t.Position=UDim2.fromOffset(14,14) t.Size=UDim2.new(1,-28,0,48) t.TextWrapped=true
	local function mk(text,x,fill)
		local b=new("TextButton",{Position=UDim2.new(x,x==0 and 14 or 6,1,-48),Size=UDim2.new(.5,-20,0,34),BackgroundColor3=fill,Text=text,TextColor3=WHITE,Font=GB,TextSize=13,AutoButtonColor=false,Parent=d})
		corner(b,8) interactive(b,b)
		return b
	end
	local no=mk("No",0,Color3.fromRGB(34,34,40))
	local yes=mk("Yes",.5,self.Accent)
	no.Activated:Connect(function()
		tw(sc,.2,{Scale=.7}) tw(ov,.2,{BackgroundTransparency=1})
		task.delay(.22,function() ov:Destroy() end)
	end)
	yes.Activated:Connect(function()
		tw(sc,.25,{Scale=.01}) task.wait(.25)
		self:Destroy()
	end)
end

function HE.CreateWindow(a,b)
	local o=(a==HE) and b or a
	o=o or {}
	local accent=typeof(o.Color)=="Color3" and o.Color or COLORS[o.Color or "Crimson"] or COLORS.Crimson
	local gui=new("ScreenGui",{Name="HE_UI",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=999})
	pcall(function() gui.Parent=guiParent() end)
	if not gui.Parent then gui.Parent=LP:WaitForChild("PlayerGui") end
	loading(gui,accent)

	local size=o.Size or UDim2.new(0,600,0,357)
	local self=setmetatable({Gui=gui,Accent=accent,Tabs={},tabN=0,Conns={},FullSize=size,Visible=true,Half=false},Window)

	local root=new("Frame",{Size=size,Position=UDim2.new(.5,-size.X.Offset/2,.5,-size.Y.Offset/2),BackgroundTransparency=1,Parent=gui})
	local rs=new("UIScale",{Parent=root}) rs.Scale=.01 tw(rs,.45,{Scale=1},Enum.EasingStyle.Back)
	self.Root,self.RootScale=root,rs
	new("ImageLabel",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.new(1,70,1,70),BackgroundTransparency=1,Image="rbxassetid://6014261993",ImageColor3=Color3.new(0,0,0),ImageTransparency=.3,ScaleType=Enum.ScaleType.Slice,SliceCenter=Rect.new(49,49,450,450),Parent=root})
	local main=new("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=WHITE,ClipsDescendants=true,Parent=root})
	corner(main,10)
	local ms=stroke(main,accent,1.5,o.BorderTransparency or o.CornerTransparency or .35)
	new("UIGradient",{Color=ColorSequence.new(Color3.fromRGB(20,20,23),Color3.fromRGB(5,5,6)),Rotation=90,Parent=main})
	self.Main=main

	-- header
	local header=new("Frame",{Size=UDim2.new(1,0,0,42),BackgroundTransparency=1,Active=true,Parent=main})
	new("Frame",{Position=UDim2.new(0,10,0,41),Size=UDim2.new(1,-20,0,1),BackgroundColor3=WHITE,BorderSizePixel=0,Parent=header})
	local hi=new("ImageLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(12,7),Size=UDim2.fromOffset(26,26),Parent=header})
	local hasIcon=setIcon(hi,o.Icon)
	hi.Visible=hasIcon
	self.HIcon=hi
	self.TitleX=hasIcon and 46 or 14
	local title=txt(header,o.Name or "HE Hub",16,GB) title.Position=UDim2.new(0,self.TitleX,0,3) title.Size=UDim2.new(1,-190,0,22)
	new("UIGradient",{Color=ColorSequence.new(WHITE,Color3.fromRGB(150,150,155)),Parent=title})
	local sub=txt(header,o.Subtitle or "",11,G,SUB) sub.Position=UDim2.new(0,self.TitleX,0,23) sub.Size=UDim2.new(1,-190,0,14)
	self.Title,self.Sub=title,sub
	makeDraggable(header,root,function() return o.Draggable~=false end,self.Conns)
	header.InputBegan:Connect(function(i) if isPress(i) then ripple(main,i.Position.X,i.Position.Y) click() end end)

	local function hbtn(x)
		local b=new("TextButton",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,x,0,20),Size=UDim2.fromOffset(26,26),BackgroundColor3=Color3.fromRGB(22,22,26),Text="",AutoButtonColor=false,Parent=header})
		corner(b,6) local s=stroke(b,LINE,1) interactive(b,b)
		b.MouseEnter:Connect(function() tw(s,.2,{Color=accent}) end)
		b.MouseLeave:Connect(function() tw(s,.2,{Color=LINE}) end)
		return b
	end
	local function img(b,id) new("ImageLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(4,4),Size=UDim2.new(1,-8,1,-8),Image="rbxassetid://"..id,Parent=b}) end
	local closeB=hbtn(-10) img(closeB,"3868133279")
	local halfB=hbtn(-42) img(halfB,"96708233182403")
	local hideB=hbtn(-74)
	new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(12,2),BackgroundColor3=WHITE,BorderSizePixel=0,Parent=hideB})
	closeB.Activated:Connect(function() self:_confirm() end)
	halfB.Activated:Connect(function() self:ToggleHalf() end)
	hideB.Activated:Connect(function() self:SetVisible(false) end)

	-- sidebar + content
	local sb=new("Frame",{Position=UDim2.fromOffset(0,42),Size=UDim2.new(0,150,1,-42),BackgroundColor3=Color3.fromRGB(7,7,8),BorderSizePixel=0,Parent=main})
	new("Frame",{AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,0,0,0),Size=UDim2.new(0,1,1,0),BackgroundColor3=LINE,BorderSizePixel=0,Parent=sb})
	local tl=new("ScrollingFrame",{Position=UDim2.fromOffset(6,8),Size=UDim2.new(1,-13,1,-12),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=0,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,Parent=sb})
	new("UIListLayout",{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder,Parent=tl})
	local content=new("Frame",{Position=UDim2.fromOffset(150,42),Size=UDim2.new(1,-150,1,-42),BackgroundTransparency=1,Parent=main})
	local top=new("Frame",{Position=UDim2.fromOffset(12,4),Size=UDim2.new(1,-20,0,26),BackgroundTransparency=1,Parent=content})
	local tt=txt(top,"",16,GB) tt.Size=UDim2.new(0,300,1,0)
	new("UIGradient",{Color=ColorSequence.new(WHITE,Color3.fromRGB(120,120,125)),Parent=tt})
	local pages=new("Frame",{Position=UDim2.fromOffset(10,34),Size=UDim2.new(1,-14,1,-38),BackgroundTransparency=1,Parent=content})
	self.Sidebar,self.Content,self.TabList,self.TopBar,self.TabTitle,self.Pages=sb,content,tl,top,tt,pages

	-- open button
	local ob=o.OpenButton or {}
	if ob.Enabled~=false then
		local sz=ob.Size or UDim2.fromOffset(48,48)
		local ofb=new("TextButton",{Size=sz,Position=ob.Position or UDim2.new(0,20,.5,-24),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=ob.Transparency or 0,Text="HE",TextColor3=WHITE,Font=GB,TextSize=18,AutoButtonColor=false,Visible=false,Parent=gui})
		corner(ofb,12) stroke(ofb,accent,1.5,.2)
		local oi=new("ImageLabel",{BackgroundTransparency=1,Size=UDim2.new(1,-10,1,-10),Position=UDim2.fromOffset(5,5),Parent=ofb})
		if setIcon(oi,ob.Image or ob.Icon) then ofb.Text="" else oi:Destroy() end
		interactive(ofb,ofb)
		makeDraggable(ofb,ofb,function() return ob.Draggable~=false end,self.Conns)
		local startAbs
		ofb.InputBegan:Connect(function(i) if isPress(i) then startAbs=ofb.AbsolutePosition end end)
		ofb.Activated:Connect(function()
			if startAbs and (ofb.AbsolutePosition-startAbs).Magnitude>8 then return end
			self:SetVisible(true)
		end)
		self.OpenBtn=ofb
	end
	table.insert(self.Conns,UIS.InputBegan:Connect(function(i,gp)
		if not gp and i.KeyCode==(o.ToggleKey or Enum.KeyCode.RightShift) then self:SetVisible(not self.Visible) end
	end))
	return self
end


return HE
 
