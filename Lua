local function tabAnim(tab,n)
	local b,ico,lbl=tab.Button,tab.Icon,tab.Label
	if n==1 then
		local sc=b:FindFirstChild("S") or new("UIScale",{Name="S",Parent=b})
		tw(sc,.1,{Scale=.92}).Completed:Connect(function() tw(sc,.3,{Scale=1},Enum.EasingStyle.Back) end)
	elseif n==2 then
		ico.Rotation=0 tw(ico,.5,{Rotation=360},Enum.EasingStyle.Back)
	elseif n==3 then
		tw(lbl,.12,{Position=lbl.Position+UDim2.fromOffset(10,0)}).Completed:Connect(function() tw(lbl,.35,{Position=lbl.Position-UDim2.fromOffset(10,0)},Enum.EasingStyle.Back) end)
	elseif n==4 then
		tab.Button.BackgroundTransparency=.2 tw(tab.Button,.5,{BackgroundTransparency=.8})
	else
		local p=ico.Position
		task.spawn(function()
			for _,d in ipairs({4,-4,3,-3,0}) do tw(ico,.05,{Position=p+UDim2.fromOffset(d,0)}) task.wait(.05) end
		end)
	end
end

function Window:_makeTab(parent,name,icon,indent)
	self.tabN=self.tabN+1
	local acc=self.Accent
	local btn=new("TextButton",{Size=UDim2.new(1,0,0,32),BackgroundColor3=acc,BackgroundTransparency=1,Text="",AutoButtonColor=false,ClipsDescendants=true,LayoutOrder=self.tabN,Parent=parent})
	corner(btn,6)
	local bar=new("Frame",{Position=UDim2.new(0,0,.5,-8),Size=UDim2.fromOffset(3,16),BackgroundColor3=acc,BackgroundTransparency=1,BorderSizePixel=0,Parent=btn}) corner(bar,2)
	local ico=new("ImageLabel",{BackgroundTransparency=1,Size=UDim2.fromOffset(16,16),AnchorPoint=Vector2.new(.5,.5),Position=UDim2.new(0,indent+18,.5,0),ImageColor3=SUB,ImageTransparency=1,Parent=btn})
	if not setIcon(ico,icon) then ico.Visible=false end
	local lbl=txt(btn,name,12,GB,SUB) lbl.Position=UDim2.new(0,indent+(ico.Visible and 32 or 12),0,0) lbl.Size=UDim2.new(1,-indent-36,1,0)
	lbl.TextTransparency=1
	local tab={Name=name,Button=btn,Bar=bar,Icon=ico,Label=lbl}
	tab.Page=makePage(newScroll(self.Pages),self.Pages,self,name)
	interactive(btn,btn)
	btn.Activated:Connect(function() tabAnim(tab,math.random(1,5)) self:Select(tab) end)
	-- sidebar entrance animation (staggered)
	task.delay(.25+self.tabN*.07,function()
		tw(lbl,.5,{TextTransparency=0}) tw(ico,.5,{ImageTransparency=0})
		local p=lbl.Position
		lbl.Position=p+UDim2.fromOffset(-14,0) tw(lbl,.5,{Position=p},Enum.EasingStyle.Back)
	end)
	table.insert(self.Tabs,tab)
	if #self.Tabs==1 then task.defer(function() self:Select(tab) end) end
	return tab
end

function Window:Select(tab)
	for _,t in ipairs(self.Tabs) do
		local on=(t==tab)
		tw(t.Button,.2,{BackgroundTransparency=on and .8 or 1})
		tw(t.Bar,.2,{BackgroundTransparency=on and 0 or 1})
		tw(t.Bar,.3,{Size=on and UDim2.fromOffset(3,16) or UDim2.fromOffset(3,4)},Enum.EasingStyle.Back)
		tw(t.Label,.2,{TextColor3=on and TXT or SUB})
		tw(t.Icon,.2,{ImageColor3=on and TXT or SUB})
		for _,p in ipairs(t.Subs or {t.Page}) do
			p.Scroll.Visible=false
			for _,e in ipairs(p.Extra) do e.Visible=false end
		end
		if t.Chips then t.Chips.Visible=on end
	end
	local p=tab.Subs and tab.ActiveSub or tab.Page
	p.Scroll.Visible=true
	p.Scroll.Position=UDim2.new(0,0,0,14) tw(p.Scroll,.3,{Position=UDim2.new()})
	playIn(p)
	self.TabTitle.Text=tab.Name
	self.TabTitle.Position=UDim2.new(0,-12,0,0) self.TabTitle.TextTransparency=1
	tw(self.TabTitle,.3,{Position=UDim2.new(),TextTransparency=0})
	if tab.Chips then
		local w=TextService:GetTextSize(tab.Name,16,GB,Vector2.new(400,26)).X
		tab.Chips.Position=UDim2.new(0,w+22,0,0)
	end
	self.Current=tab
end

