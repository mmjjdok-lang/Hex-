end

-- heavy single-finger drag: only the finger that touched the handle moves it
local function makeDraggable(handle,target,canDrag,conns)
	local drag,startPos,startUD,goal
	handle.InputBegan:Connect(function(i)
		if drag or not isPress(i) then return end
		if canDrag and not canDrag() then return end
		drag=i startPos=i.Position startUD=target.Position goal=target.Position
		i.Changed:Connect(function()
			if i.UserInputState==Enum.UserInputState.End and drag==i then drag=nil end
		end)
	end)
	table.insert(conns,UIS.InputChanged:Connect(function(i)
		if not drag then return end
		if i==drag or (drag.UserInputType==Enum.UserInputType.MouseButton1 and i.UserInputType==Enum.UserInputType.MouseMovement) then
			local d=i.Position-startPos
			goal=UDim2.new(startUD.X.Scale,startUD.X.Offset+d.X,startUD.Y.Scale,startUD.Y.Offset+d.Y)
		end
	end))
	table.insert(conns,RS.RenderStepped:Connect(function(dt)
		if goal then target.Position=target.Position:Lerp(goal,math.clamp(dt*7,0,1)) end
	end))
end

-- area drag (sliders, colour pickers)
local function dragArea(frame,cb,scroll)
	local cur
	local function upd(pos)
		local ap,as=frame.AbsolutePosition,frame.AbsoluteSize
		cb(math.clamp((pos.X-ap.X)/as.X,0,1),math.clamp((pos.Y-ap.Y)/as.Y,0,1))
	end
	frame.InputBegan:Connect(function(i)
		if cur or not isPress(i) then return end
		cur=i
		if scroll then scroll.ScrollingEnabled=false end
		upd(i.Position)
		i.Changed:Connect(function()
			if i.UserInputState==Enum.UserInputState.End then
				cur=nil
				if scroll then scroll.ScrollingEnabled=true end
			end
		end)
	end)
	UIS.InputChanged:Connect(function(i)
		if cur and (i==cur or (cur.UserInputType==Enum.UserInputType.MouseButton1 and i.UserInputType==Enum.UserInputType.MouseMovement)) then upd(i.Position) end
	end)
end

