-- cards pop in one after another
local function playIn(p)
	if not (p and p.Scroll and p.Scroll.Parent) then return end
	local i=0
	for _,c in ipairs(p.Scroll:GetChildren()) do
		local sc=c:FindFirstChild("CS")
		if sc then
			i=i+1
			sc.Scale=.85
			task.delay(math.min(i,12)*.035,function() tw(sc,.45,{Scale=1},Enum.EasingStyle.Back) end)
		end
	end
end

