function Page:Toggle(o)
	local c=self:_card(o.Desc and 46 or 38)
	head(c,o.Name or "Toggle",o.Desc)
	local off=Color3.fromRGB(45,45,52)
	local track=new("Frame",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-12,.5,0),Size=UDim2.fromOffset(38,20),BackgroundColor3=off,Parent=c})
	corner(track,10)
	local knob=new("Frame",{Size=UDim2.fromOffset(14,14),Position=UDim2.new(0,3,.5,-7),BackgroundColor3=WHITE,Parent=track})
	corner(knob,7)
	local state=false
	local function set(v,silent)
		state=v
		tw(track,.25,{BackgroundColor3=v and self.Win.Accent or off})
		tw(knob,.25,{Position=v and UDim2.new(1,-17,.5,-7) or UDim2.new(0,3,.5,-7)},Enum.EasingStyle.Back)
		if not silent then safe(o.Callback,v) end
	end
	set(o.Default and true or false,true)
	local b=overlay(c)
	b.Activated:Connect(function() set(not state) end)
	return {Set=function(_,v) set(v) end,Get=function() return state end}
end

function Page:Slider(o)
	local min,max,inc=o.Min or 0,o.Max or 100,o.Increment or 1
	local c=self:_card(52)
	local n=txt(c,o.Name or "Slider",13,GB) n.Position=UDim2.new(0,12,0,6) n.Size=UDim2.new(1,-90,0,18)
	local vl=txt(c,"",12,G,SUB,RIGHT) vl.Position=UDim2.new(1,-82,0,6) vl.Size=UDim2.fromOffset(70,18)
	local track=new("Frame",{Position=UDim2.new(0,12,1,-16),Size=UDim2.new(1,-24,0,6),BackgroundColor3=Color3.fromRGB(40,40,46),Parent=c})
	corner(track,3)
	local fill=new("Frame",{Size=UDim2.new(0,0,1,0),BackgroundColor3=self.Win.Accent,Parent=track}) corner(fill,3)
	local knob=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(14,14),Position=UDim2.new(0,0,.5,0),BackgroundColor3=WHITE,Parent=track})
	corner(knob,7)
	local hit=new("Frame",{Position=UDim2.new(0,0,.5,-12),Size=UDim2.new(1,0,0,24),BackgroundTransparency=1,Parent=track})
	local value
	local function set(v,silent)
		v=math.clamp(math.floor((v-min)/inc+.5)*inc+min,min,max)
		if v==value then return end
		value=v
		local a=(max-min)==0 and 0 or (v-min)/(max-min)
		fill.Size=UDim2.new(a,0,1,0) knob.Position=UDim2.new(a,0,.5,0)
		vl.Text=tostring(v)
		if not silent then safe(o.Callback,v) end
	end
	set(o.Default or min,true)
	dragArea(hit,function(x) set(min+(max-min)*x) end,self.Scroll)
	return {Set=function(_,v) set(v) end,Get=function() return value end}
end

function Page:Dropdown(o)
	local win=self.Win
	local opts=o.Options or {}
	local multi=o.Multi
	local sel,single={},o.Default
	if multi and type(o.Default)=="table" then for _,v in ipairs(o.Default) do sel[v]=true end end
	local function nameOf(op) return type(op)=="table" and op.Name or tostring(op) end
	local c=self:_card(38)
	local nm=txt(c,o.Name or "Dropdown",13,GB) nm.Position=UDim2.new(0,12,0,0) nm.Size=UDim2.new(.5,-12,1,0)
	local val=txt(c,"",12,G,SUB,RIGHT) val.Position=UDim2.new(.5,0,0,0) val.Size=UDim2.new(.5,-34,1,0) val.TextTruncate=Enum.TextTruncate.AtEnd
	local ar=txt(c,"v",12,GB,SUB,CENTER) ar.Position=UDim2.new(1,-26,0,0) ar.Size=UDim2.fromOffset(18,38)
	local function list()
		local t={}
		for _,op in ipairs(opts) do if sel[nameOf(op)] then t[#t+1]=nameOf(op) end end
		return t
	end
	local function refresh()
		if multi then
			local t=list()
			val.Text=#t==0 and "None" or (#t>2 and (#t.." selected") or table.concat(t,", "))
		else val.Text=single and tostring(single) or "Select" end
	end
	refresh()
	local closeFn
	local function open()
		local main=win.Main
		local blocker=new("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",ZIndex=40,Parent=main})
		local searchH=o.Search and 34 or 0
		local listH=math.min(#opts*28,140)+4
		local H=searchH+listH+6
		local ap=c.AbsolutePosition-main.AbsolutePosition
		local W=math.clamp(c.AbsoluteSize.X*.6,170,260)
		local x=math.clamp(ap.X+c.AbsoluteSize.X-W,6,math.max(6,main.AbsoluteSize.X-W-6))
		local above=ap.Y-H-4>=44
		local f=new("Frame",{AnchorPoint=Vector2.new(0,above and 1 or 0),Position=UDim2.fromOffset(x,above and ap.Y-4 or ap.Y+c.AbsoluteSize.Y+4),Size=UDim2.fromOffset(W,0),BackgroundColor3=Color3.fromRGB(12,12,15),ClipsDescendants=true,ZIndex=41,Parent=main})
		corner(f,8) stroke(f,win.Accent,1,.35)
		tw(f,.28,{Size=UDim2.fromOffset(W,H)},Enum.EasingStyle.Back)
		local box
		if o.Search then
			local row=new("Frame",{Position=UDim2.fromOffset(6,5),Size=UDim2.new(1,-12,0,26),BackgroundColor3=Color3.fromRGB(24,24,28),Parent=f}) corner(row,6)
			new("ImageLabel",{BackgroundTransparency=1,Size=UDim2.fromOffset(16,16),Position=UDim2.fromOffset(7,5),Image="rbxassetid://74359225654527",Parent=row})
			box=new("TextBox",{BackgroundTransparency=1,Position=UDim2.fromOffset(30,0),Size=UDim2.new(1,-34,1,0),Text="",PlaceholderText="Search...",PlaceholderColor3=SUB,TextColor3=TXT,Font=G,TextSize=12,TextXAlignment=LEFT,ClearTextOnFocus=false,Parent=row})
		end
		local lst=newScroll(f) lst.Visible=true lst.Position=UDim2.fromOffset(6,searchH+3) lst.Size=UDim2.new(1,-12,0,listH)
		lst.UIListLayout.Padding=UDim.new(0,2)
		local function close()
			if not blocker.Parent then return end
			blocker:Destroy() closeFn=nil
			tw(f,.2,{Size=UDim2.fromOffset(W,0)})
			task.delay(.22,function() f:Destroy() end)
		end
		closeFn=close
		local function build()
			local q=box and box.Text:lower() or ""
			for _,ch in ipairs(lst:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
			for _,op in ipairs(opts) do
				local n=nameOf(op)
				if q=="" or n:lower():find(q,1,true) then
					local picked=multi and sel[n] or (not multi and single==n)
					local b=new("TextButton",{Size=UDim2.new(1,0,0,26),BackgroundColor3=Color3.fromRGB(28,28,34),BackgroundTransparency=picked and 0 or 1,Text="",Parent=lst}) corner(b,6)
					local hasIcon=type(op)=="table" and op.Icon
					if hasIcon then
						local im=new("ImageLabel",{BackgroundTransparency=1,Size=UDim2.fromOffset(16,16),Position=UDim2.new(0,6,.5,-8),Parent=b})
						setIcon(im,op.Icon)
					end
					local l=txt(b,n,12,G,picked and win.Accent or TXT) l.Position=UDim2.new(0,hasIcon and 28 or 8,0,0) l.Size=UDim2.new(1,-36,1,0)
					interactive(b,b)
					b.Activated:Connect(function()
						if multi then
							sel[n]=not sel[n] or nil
							refresh() build()
							safe(o.Callback,list())
						else
							single=n refresh() close()
							safe(o.Callback,n)
						end
					end)
				end
			end
		end
		build()
		if box then box:GetPropertyChangedSignal("Text"):Connect(build) end
		blocker.Activated:Connect(close)
	end
	local b=overlay(c)
	b.Activated:Connect(function() if closeFn then closeFn() else open() end end)
	return {Get=function() return multi and list() or single end}
end

