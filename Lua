-- Color picker: one professional picker (saturation/value square + hue bar + hex)
function Page:AddColorPicker(cfg)
	cfg = cfg or {}
	local window = self.Window
	local color = cfg.Default or WHITE
	local h, s, v = color:ToHSV()

	local row = self:_Row(50)
	RowText(row, cfg.Name or "Color", cfg.Description, 60)

	local swatch = Create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(36, 22),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
		Parent = row,
	})
	Corner(swatch, 4)
	Stroke(swatch, 0.4, 1)

	local pop = Create("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Size = UDim2.fromOffset(200, 0),
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 50,
		Parent = window.Frame,
	})
	Corner(pop, 6)
	Stroke(pop, 0.4, 1)

	local sv = Create("Frame", {
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(184, 130),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 51,
		Parent = pop,
	})
	Corner(sv, 4)
	local whiteLayer = Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 52,
		Parent = sv,
	})
	Create("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = whiteLayer })
	local blackLayer = Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		ZIndex = 52,
		Parent = sv,
	})
	Create("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90, Parent = blackLayer })
	local svKnob = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1,
		ZIndex = 54,
		Parent = sv,
	})
	Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = svKnob })
	Stroke(svKnob, 0, 2, WHITE)

	local hue = Create("Frame", {
		Position = UDim2.fromOffset(8, 148),
		Size = UDim2.fromOffset(184, 14),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 51,
		Parent = pop,
	})
	Corner(hue, 4)
	Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hue,
	})
	local hueKnob = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(4, 18),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 53,
		Parent = hue,
	})
	local hexLabel = Create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 170),
		Size = UDim2.new(1, -16, 0, 20),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 51,
		Parent = pop,
	})

	local function Hex(c)
		return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
	end

	local function Update(fire)
		color = Color3.fromHSV(h, s, v)
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		swatch.BackgroundColor3 = color
		svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
		hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
		hexLabel.Text = Hex(color)
		if fire and cfg.Callback then
			task.spawn(cfg.Callback, color)
		end
	end
	Update(false)

	local dragInput, dragMode
	local function Read(input)
		if dragMode == "sv" then
			s = math.clamp((input.Position.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
			v = 1 - math.clamp((input.Position.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
		elseif dragMode == "hue" then
			h = math.clamp((input.Position.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 1)
		end
		Update(true)
	end
	local function StartDrag(mode)
		return function(input)
			if dragInput or not IsPress(input) then
				return
			end
			dragInput = input
			dragMode = mode
			Read(input)
		end
	end
	sv.InputBegan:Connect(StartDrag("sv"))
	hue.InputBegan:Connect(StartDrag("hue"))
	UserInputService.InputChanged:Connect(function(input)
		if dragInput and (input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then
			Read(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragInput and (input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			dragInput = nil
			dragMode = nil
		end
	end)

	local open = false
	local function Open()
		open = true
		local rel = swatch.AbsolutePosition - window.Frame.AbsolutePosition
		pop.Position = UDim2.fromOffset(rel.X + swatch.AbsoluteSize.X, rel.Y - 6)
		pop.Size = UDim2.fromOffset(200, 0)
		pop.Visible = true
		Tween(pop, 0.25, { Size = UDim2.fromOffset(200, 200) })
	end
	local function Close()
		open = false
		local t = Tween(pop, 0.2, { Size = UDim2.fromOffset(200, 0) })
		t.Completed:Connect(function()
			if not open then
				pop.Visible = false
			end
		end)
	end
	BindPress(swatch, function()
		if open then
			Close()
		else
			Open()
		end
	end)

	local obj = {}
	function obj:Set(c)
		h, s, v = c:ToHSV()
		Update(false)
	end
	function obj:Get()
		return color
	end
	return obj
end

