local SHAPES={}
do
	local function add(name,r,aw,ah,rot) SHAPES[#SHAPES+1]={Name=name,r=r,aw=aw or 1,ah=ah or 1,rot=rot or 0} end
	for _,r in ipairs({0,2,3,4,6,8,10,12,14,16,18,20,24,28,999}) do add(r==0 and "Square" or (r==999 and "Circle" or ("Rounded "..r)),r) end
	for _,r in ipairs({0,4,8,12,16,20,24,999}) do add("Wide "..(r==999 and "Pill" or ("R"..r)),r,1.6,1) end
	for _,r in ipairs({0,8,16,999}) do add("Tall "..(r==999 and "Pill" or ("R"..r)),r,.7,1) end
	add("Diamond",0,1,1,45) add("Soft Diamond",6,1,1,45) add("Long Pill",999,2.2,1)
end
local SHAPE_MAP,SHAPE_NAMES={},{}
for _,sh in ipairs(SHAPES) do SHAPE_MAP[sh.Name]=sh SHAPE_NAMES[#SHAPE_NAMES+1]=sh.Name end

local function parseSize(t)
	t=tostring(t):lower():gsub("%s","")
	local a,b=t:match("^(%d+%.?%d*)x(%d+%.?%d*)$")
	if not a then a=t:match("^(%d+%.?%d*)$") b=a end
	a,b=tonumber(a) or 30,tonumber(b) or 30
	return math.clamp(a,16,200),math.clamp(b,16,200)
end

local function buildFB(win,cfg,run,ctl,parent,preview)
	local b=new("TextButton",{AnchorPoint=Vector2.new(.5,.5),BackgroundColor3=Color3.fromRGB(14,14,16),BorderSizePixel=0,Text="",AutoButtonColor=false,Parent=parent})
	local cr=corner(b,8)
	local st=new("UIStroke",{ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Color=WHITE,Parent=b})
	local gr=new("UIGradient",{Parent=st})
	local lbl=new("TextLabel",{BackgroundTransparency=1,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.new(1,-6,1,-6),Text="",Font=GB,TextColor3=WHITE,TextScaled=true,Parent=b})
	new("UITextSizeConstraint",{MaxTextSize=14,MinTextSize=5,Parent=lbl})
	local ps=new("UIScale",{Scale=0,Parent=b})
	tw(ps,.5,{Scale=1},Enum.EasingStyle.Back)
	local obj={}
	local function style()
		if not b.Parent then return end
		local on=ctl and ctl.Get() or false
		b.BackgroundColor3=on and win.Accent or Color3.fromRGB(14,14,16)
		lbl.TextColor3=on and onAcc(win.Accent) or WHITE
	end
	function obj.Update()
		local sh=SHAPE_MAP[cfg.Shape] or SHAPE_MAP["Rounded 8"]
		local sx,sy=parseSize(cfg.SizeText)
		b.Size=UDim2.fromOffset(sx*sh.aw,sy*sh.ah)
		cr.CornerRadius=UDim.new(0,sh.r)
		b.Rotation=sh.rot lbl.Rotation=-sh.rot
		lbl.Text=(cfg.Name and cfg.Name~="") and cfg.Name or " "
		st.Thickness=cfg.GSize
		st.Transparency=1-math.clamp(cfg.GStrength,0,100)/100
		local n,kp=#cfg.Colors,{}
		for i,c in ipairs(cfg.Colors) do kp[i]=ColorSequenceKeypoint.new(n==1 and 0 or (i-1)/(n-1),Color3.fromRGB(c[1],c[2],c[3])) end
		if n==1 then kp[2]=ColorSequenceKeypoint.new(1,kp[1].Value) end
		gr.Color=ColorSequence.new(kp)
		style()
	end
	local conn=RS.Heartbeat:Connect(function(dt) gr.Rotation=(gr.Rotation+cfg.GSpeed*dt)%360 end)
	table.insert(win.Conns,conn)
	if ctl and ctl.Listen then ctl.Listen(style) end
	if preview then
		b.Position=UDim2.fromScale(.5,.5)
	else
		b.Position=cfg.Pos and UDim2.new(cfg.Pos[1],cfg.Pos[2],cfg.Pos[3],cfg.Pos[4]) or UDim2.new(.5,0,.3,0)
		interactive(b,b)
		makeDraggable(b,b,function() return cfg.Draggable end,win.Conns,function(goal)
			if goal then cfg.Pos={goal.X.Scale,goal.X.Offset,goal.Y.Scale,goal.Y.Offset} win:Save() end
		end)
		local start
		b.InputBegan:Connect(function(i) if isPress(i) then start=b.AbsolutePosition tw(ps,.08,{Scale=.88}) end end)
		b.InputEnded:Connect(function(i) if isPress(i) then tw(ps,.3,{Scale=1},Enum.EasingStyle.Back) end end)
		b.Activated:Connect(function()
			if start and (b.AbsolutePosition-start).Magnitude>8 then return end
			safe(run)
		end)
	end
	function obj.Destroy() conn:Disconnect() b:Destroy() end
	return obj
end

function Page:_attachFloating(c,o,kind,ctl,run)
	local win=self.Win
	local key="fb/"..(self.Key and (self.Key.."/") or "")..tostring(o.Name or kind)
	local cfg=win.Data.fb[key]
	if type(cfg)~="table" then cfg={} win.Data.fb[key]=cfg end
	local def={Name=o.Name or kind,SizeText="30x30",Shape="Rounded 8",Draggable=true,Colors={{14,14,16},{255,255,255},{14,14,16}},GSize=2,GSpeed=90,GStrength=100,Enabled=false}
	for k,v in pairs(def) do if cfg[k]==nil then cfg[k]=v end end
	for i=1,3 do cfg.Colors[i]=cfg.Colors[i] or def.Colors[i] end
	local live,prev,ed,s1,s2
	local function showLive()
		if live then live.Update() else live=buildFB(win,cfg,run,ctl,win.Gui,false) live.Update() end
