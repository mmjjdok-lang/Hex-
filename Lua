function Page:Button(o)
	local c=self:_card(o.Desc and 46 or 38)
	local fl=not self.NoFloat
	head(c,o.Name or "Button",o.Desc,fl and 34 or 12)
	local b=overlay(c)
	b.Activated:Connect(function() safe(o.Callback) end)
	b.MouseEnter:Connect(function() tw(CardStroke[c],.2,{Color=self.Win.Accent}) end)
	b.MouseLeave:Connect(function() tw(CardStroke[c],.2,{Color=LINE}) end)
	if fl then self:_attachFloating(c,o,"Button",nil,function() safe(o.Callback) end) end
	return c
end

function Page:Toggle(o)
	local c=self:_card(o.Desc and 46 or 38)
	local fl=not self.NoFloat
	head(c,o.Name or "Toggle",o.Desc,fl and 34 or 12)
	local off=Color3.fromRGB(45,45,52)
	local track=new("Frame",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-12,.5,0),Size=UDim2.fromOffset(38,20),BackgroundColor3=off,Parent=c})
	corner(track,10)
	local knob=new("Frame",{Size=UDim2.fromOffset(14,14),Position=UDim2.new(0,3,.5,-7),BackgroundColor3=WHITE,Parent=track})
	corner(knob,7)
	local key=self:_key(o.Name)
	local saved=self:_saved(key)
	local state=false
	local listeners={}
	local function set(v,silent)
		state=v
		tw(track,.25,{BackgroundColor3=v and self.Win.Accent or off})
		tw(knob,.25,{BackgroundColor3=v and onAcc(self.Win.Accent) or WHITE})
		tw(knob,.25,{Position=v and UDim2.new(1,-17,.5,-7) or UDim2.new(0,3,.5,-7)},Enum.EasingStyle.Back)
		for _,f in ipairs(listeners) do f(v) end
		if not silent then self:_store(key,v) safe(o.Callback,v) end
	end
	set(saved~=nil and saved or (o.Default and true or false),true)
	if saved~=nil then task.defer(function() safe(o.Callback,state) end) end
	local b=overlay(c)
	b.Activated:Connect(function() set(not state) end)
	b.MouseEnter:Connect(function() tw(CardStroke[c],.2,{Color=self.Win.Accent}) end)
	b.MouseLeave:Connect(function() tw(CardStroke[c],.2,{Color=LINE}) end)
	local ctl={Set=function(_,v) set(v) end,Get=function() return state end,Toggle=function() set(not state) end,Listen=function(f) listeners[#listeners+1]=f end}
	if fl then self:_attachFloating(c,o,"Toggle",ctl,function() set(not state) end) end
	return ctl
end

