----------------------------------------------------------------- helpers
local function new(c,p)
	local o=Instance.new(c)
	for k,v in pairs(p or {}) do o[k]=v end
	return o
end
local function tw(o,t,p,style,dir)
	local x=TS:Create(o,TweenInfo.new(t,style or Enum.EasingStyle.Quint,dir or Enum.EasingDirection.Out),p)
	x:Play() return x
end
local function corner(o,r) return new("UICorner",{CornerRadius=UDim.new(0,r),Parent=o}) end
local function stroke(o,c,t,tr) return new("UIStroke",{Color=c,Thickness=t or 1,Transparency=tr or 0,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=o}) end
local function txt(p,t,s,f,c,xa)
	return new("TextLabel",{BackgroundTransparency=1,Text=t,TextSize=s or 13,Font=f or G,TextColor3=c or TXT,TextXAlignment=xa or LEFT,Parent=p})
end
local function safe(f,...)
	if type(f)=="function" then
		local ok,e=pcall(f,...)
		if not ok then warn("[HE] "..tostring(e)) end
	end
end
local function onAcc(c) return (0.299*c.R+0.587*c.G+0.114*c.B)>.6 and Color3.new(0,0,0) or Color3.new(1,1,1) end
local function hex(c) return string.format("#%02X%02X%02X",math.floor(c.R*255+.5),math.floor(c.G*255+.5),math.floor(c.B*255+.5)) end

local sound=new("Sound",{SoundId="rbxassetid://3868133279",Volume=.6,Parent=SS})
local function click() sound.TimePosition=0 sound:Play() end

-- water-drop ripple at the pressed point
local function ripple(host,x,y)
	host.ClipsDescendants=true
	local ap,as=host.AbsolutePosition,host.AbsoluteSize
	local m=math.max(as.X,as.Y)*2
	local c=new("Frame",{BackgroundColor3=WHITE,BackgroundTransparency=.75,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(x-ap.X,y-ap.Y),Size=UDim2.fromOffset(0,0),ZIndex=host.ZIndex+20,Parent=host})
	corner(c,999)
	local s=stroke(c,WHITE,2,.4)
	tw(c,.65,{Size=UDim2.fromOffset(m,m),BackgroundTransparency=1})
	tw(s,.65,{Transparency=1})
	task.delay(.7,function() c:Destroy() end)
end
local function isPress(i) return i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch end
local function interactive(btn,host)
	btn.AutoButtonColor=false
	btn.InputBegan:Connect(function(i)
		if isPress(i) then ripple(host or btn,i.Position.X,i.Position.Y) click() end
	end)
end

-- moving light-black gradient on a text label
local function movingGrad(lbl,conns,speed)
	local g=new("UIGradient",{Color=ColorSequence.new({
		ColorSequenceKeypoint.new(0,Color3.fromRGB(255,255,255)),
		ColorSequenceKeypoint.new(.5,Color3.fromRGB(80,80,90)),
		ColorSequenceKeypoint.new(1,Color3.fromRGB(255,255,255))}),Parent=lbl})
	local t0=tick()
	table.insert(conns,RS.Heartbeat:Connect(function()
		g.Offset=Vector2.new(((tick()-t0)*(speed or .35)%2)-1,0)
	end))
	return g
end

----------------------------------------------------------------- icons
-- Uses the original Footagesus Icons library:
--   IconsV2.SetIconsType("lucide") ; IconsV2.GetIcon("house") ; "sfsymbols:HouseFill"
-- Loaded in the background the moment the script runs (fast). Icons asked for before
-- it finishes are queued and filled in automatically, then preloaded.
local IconsLib
local IconsReady=false
local pending={}
local warnedKeys=false

local function fetch(url)
	local ok,r=pcall(function() return game:HttpGetAsync(url) end)
	if ok and type(r)=="string" and #r>20 then return r end
	ok,r=pcall(function() return game:HttpGet(url) end)
	if ok and type(r)=="string" and #r>20 then return r end
	local req=(syn and syn.request) or (http and http.request) or http_request or request
	if req then
		local ok2,res=pcall(req,{Url=url,Method="GET"})
		if ok2 and res and type(res.Body)=="string" and #res.Body>20 then return res.Body end
	end
end
local function assetUrl(v)
	v=tostring(v)
	if tonumber(v) then return "rbxassetid://"..v end
	return v
end
local function preload(img)
	task.spawn(function() pcall(function() CP:PreloadAsync({img}) end) end)
end
local function applyResult(img,r)
	if type(r)=="string" then img.Image=assetUrl(r) return true end
	if type(r)~="table" then return false end
	local id=r.Image or r.Id or r.id or r.Asset or r[1]
	local rect=type(r[2])=="table" and r[2] or r
	if type(id)=="string" or type(id)=="number" then
		img.Image=assetUrl(id)
		local rs=rect.ImageRectSize or rect.Size
		local rp=rect.ImageRectPosition or rect.ImageRectOffset or rect.Position
		if typeof(rs)=="Vector2" then img.ImageRectSize=rs end
		if typeof(rp)=="Vector2" then img.ImageRectOffset=rp end
		return true
	end
	return false
end
local function resolve(img,icon)
	if type(IconsLib)~="table" then return false end
	local nm=tostring(icon)
	local low=nm:lower()
	local tries={nm,low,(low:gsub("[_%s]+","-"))}
	for _,n in ipairs(tries) do
		for _,k in ipairs({"GetIcon","Icon"}) do
			local fn=IconsLib[k]
			if type(fn)=="function" then
				local ok,r=pcall(fn,n)
				if ok and r and applyResult(img,r) then return true end
			end
		end
	end
	return false
end
local function warnIcon(icon)
	if warnedKeys then return end
	warnedKeys=true
	warn("[HE] icon '"..tostring(icon).."' not found in the Icons library (use names like \"house\", \"sword\", \"user\" or \"sfsymbols:HouseFill\")")
end
local function loadIcons()
	for _,url in ipairs(ICONS_URLS) do
		local body=fetch(url)
		local f=body and loadstring(body)
		if f then
			local ok,lib=pcall(f)
			if ok and lib then
				if type(lib)=="function" then local ok2,l=pcall(lib) if ok2 then lib=l end end
				if type(lib)=="table" then
					pcall(function() if lib.SetIconsType then lib.SetIconsType("lucide") end end)
					IconsLib=lib break
				end
			end
		end
	end
	if not IconsLib then warn("[HE] could not load the Icons library (use asset ids instead)") end
	IconsReady=true
	for _,p in ipairs(pending) do
		local img,name=p[1],p[2]
		if img.Parent then
			if resolve(img,name) then preload(img) else img.Visible=false warnIcon(name) end
		end
	end
	pending={}
end
task.spawn(loadIcons)

local function setIcon(img,icon)
	if not icon or icon=="" then return false end
	local s=tostring(icon)
	if tonumber(s) or s:find("rbx") or s:find("http") then img.Image=assetUrl(s) preload(img) return true end
	if IconsReady then
		if resolve(img,s) then preload(img) return true end
		warnIcon(s) return false
	end
	pending[#pending+1]={img,s}
	return true
end

local function guiParent()
	local ok,h=pcall(function() return gethui and gethui() end)
	if ok and h then return h end
	local ok2=pcall(function() return game:GetService("CoreGui"):GetChildren() end)
	if ok2 then return game:GetService("CoreGui") end
	return LP:WaitForChild("PlayerGui")
end

-- heavy single-finger drag: only the finger that touched the handle moves it
local function makeDraggable(handle,target,canDrag,conns,onEnd)
	local drag,startPos,startUD,goal
	handle.InputBegan:Connect(function(i)
		if drag or not isPress(i) then return end
		if canDrag and not canDrag() then return end
		drag=i startPos=i.Position startUD=target.Position goal=target.Position
		i.Changed:Connect(function()
			if i.UserInputState==Enum.UserInputState.End and drag==i then drag=nil if onEnd then onEnd(goal) end end
		end)
	end)
	table.insert(conns,UIS.InputChanged:Connect(function(i)
		if not drag then return end
		if i==drag or (drag.UserInputType==Enum.UserInputType.MouseButton1 and i.UserInputType==Enum.UserInputType.MouseMovement) then
			local d=i.Position-startPos
			goal=UDim2.new(startUD.X.Scale,startUD.X.Offset+d.X,startUD.Y.Scale,startUD.Y.Offset+d.Y)
		end
	end))
	table.insert(conns,RS.RenderStepped:Connect(function(dt)
		if goal then target.Position=target.Position:Lerp(goal,math.clamp(dt*7,0,1)) end
	end))
end

-- area drag (sliders, colour pickers)
local function dragArea(frame,cb,scroll)
	local cur
	local function upd(pos)
		local ap,as=frame.AbsolutePosition,frame.AbsoluteSize
		cb(math.clamp((pos.X-ap.X)/as.X,0,1),math.clamp((pos.Y-ap.Y)/as.Y,0,1))
	end
	frame.InputBegan:Connect(function(i)
		if cur or not isPress(i) then return end
		cur=i
		if scroll then scroll.ScrollingEnabled=false end
		upd(i.Position)
		i.Changed:Connect(function()
			if i.UserInputState==Enum.UserInputState.End then
				cur=nil
				if scroll then scroll.ScrollingEnabled=true end
			end
		end)
	end)
	UIS.InputChanged:Connect(function(i)
		if cur and (i==cur or (cur.UserInputType==Enum.UserInputType.MouseButton1 and i.UserInputType==Enum.UserInputType.MouseMovement)) then upd(i.Position) end
	end)
end

