-- Skin panel: avatar preview (drag to rotate 360), player name apply,
-- category list, effects dropdown, purple joint trails.
function Page:AddSkin(cfg)
	cfg = cfg or {}
	local box = self:AddBox({ Title = cfg.Title or "Skin" })
	local effects = cfg.Effects or { "None", "Headless", "Korblox", "Rainbow", "Fire" }

	local vp = Create("ViewportFrame", {
		Size = UDim2.new(1, 0, 0, 230),
		BackgroundColor3 = Color3.fromRGB(8, 8, 8),
		BorderSizePixel = 0,
		LayoutOrder = box:_NextOrder(),
		Parent = box.Holder,
	})
	Corner(vp)
	Stroke(vp, 0.6, 1)
	local world = Create("WorldModel", { Parent = vp })
	local cam = Create("Camera", { Parent = vp })
	vp.CurrentCamera = cam
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 2.8, 8), Vector3.new(0, 2.8, 0))

	local rotY = 0
	local model
	local currentDesc
	local effectName = "None"
	local effectConn
	local trailOn = false
	local charTrails = {}
	local dragInput, lastX

	local function Pose()
		if model then
			model:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, rotY, 0))
		end
	end

	local function Build(desc)
		if effectConn then
			effectConn:Disconnect()
			effectConn = nil
		end
		if model then
			model:Destroy()
			model = nil
		end
		local ok, m = pcall(function()
			return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		end)
		if not ok or not m then
			return false
		end
		model = m
		for _, p in ipairs(m:GetDescendants()) do
			if p:IsA("BasePart") then
				p.Anchored = true
			end
		end
		m.Parent = world
		Pose()
		effectConn = ApplyEffect(m, effectName)
		if trailOn then
			ApplyTrails(m)
		end
		return true
	end

	-- Drag to rotate (single finger / mouse)
	vp.InputBegan:Connect(function(input)
		if dragInput or not IsPress(input) then
			return
		end
		dragInput = input
		lastX = input.Position.X
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragInput and (input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then
			rotY += (input.Position.X - lastX) * 0.012
			lastX = input.Position.X
			Pose()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragInput and (input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			dragInput = nil
		end
	end)

	-- Name input
	local nameRow = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		LayoutOrder = box:_NextOrder(),
		Parent = box.Holder,
	})
	Corner(nameRow)
	Stroke(nameRow, 0.5, 1)
	local nameBox = Create("TextBox", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -20, 1, 0),
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = WHITE,
		PlaceholderText = "Player name",
		PlaceholderColor3 = GRAY,
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = nameRow,
	})
	local status = box:AddLabel({ Text = "Type a player name, then press Apply", TextSize = 12, Color = GRAY })

	local function ApplyByName(name)
		name = string.gsub(string.gsub(name, "^%s+", ""), "%s+$", "")
		if name == "" then
			status:Set("Type a player name first")
			return
		end
		status:Set("Loading " .. name .. "...")
		local ok, userId = pcall(function()
			return Players:GetUserIdFromNameAsync(name)
		end)
		if not ok then
			status:Set("User not found")
			return
		end
		local ok2, desc = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(userId)
		end)
		if not ok2 or not desc then
			status:Set("Could not load this skin")
			return
		end
		currentDesc = desc
		Build(desc)
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			pcall(function()
				hum:ApplyDescription(desc)
			end)
		end
		status:Set("Applied skin of " .. name)
	end

	box:AddButton({
		Name = "Apply Skin",
		Description = "Loads this player's full look",
		Callback = function()
			ApplyByName(nameBox.Text)
		end,
	})

	-- Categories: shows the current value of the chosen category
	local categoryNames = {}
	for _, c in ipairs(SKIN_CATEGORIES) do
		table.insert(categoryNames, c[1])
	end
	local categoryInfo = box:AddLabel({ Text = "Select a category to see its value", TextSize = 12, Color = GRAY })
	box:AddDropdown({
		Name = "Category",
		Options = categoryNames,
		Default = categoryNames[1],
		Search = true,
		Callback = function(name)
			local prop
			for _, c in ipairs(SKIN_CATEGORIES) do
				if c[1] == name then
					prop = c[2]
				end
			end
			local value = currentDesc and prop and currentDesc[prop]
			categoryInfo:Set(name .. ": " .. tostring(value or "-"))
		end,
	})

	box:AddDropdown({
		Name = "Effect",
		Options = effects,
		Default = "None",
		Callback = function(name)
			effectName = name
			if currentDesc then
				Build(currentDesc)
			end
		end,
	})

	box:AddToggle({
		Name = "Joint Trails",
		Description = "Purple fading trails on shoulders, hands and knees",
		Default = false,
		Callback = function(on)
			trailOn = on
			if currentDesc then
				Build(currentDesc)
			end
			for _, o in ipairs(charTrails) do
				o:Destroy()
			end
			charTrails = {}
			if on and LocalPlayer.Character then
				charTrails = ApplyTrails(LocalPlayer.Character)
			end
		end,
	})

	-- Start with your own look
	task.spawn(function()
		local ok, desc = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
		end)
		if ok and desc then
			currentDesc = desc
			Build(desc)
		end
	end)

	return box
end

-- Sub-tab: a button in the tab header (next to the tab name) that opens its own page
function Page:CreateSubTab(cfg)
	cfg = cfg or {}
	local window = self.Window
	local scroll = Create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, CONTENT_TOP),
		Size = UDim2.new(1, 0, 1, -CONTENT_TOP),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = WHITE,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
		Parent = window.Content,
	})
	Create("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		Parent = scroll,
	})
	local btn = Create("TextButton", {
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = cfg.Name or "Sub",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = GRAY,
		AutoButtonColor = false,
		ZIndex = 4,
		Parent = self.SubBar,
	})
	Corner(btn)
	Create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = btn })

	local sub = setmetatable({ Name = cfg.Name or "Sub", Button = btn, Scroll = scroll }, Page)
	sub:_Init(scroll, window)
	table.insert(self.Subs, sub)
	BindPress(btn, function()
		self:SelectSub(sub)
	end)
	if #self.Subs == 1 then
		self:SelectSub(sub)
	end
	return sub
end

function Page:SelectSub(sub)
	self.ActivePage = sub
	for _, s in ipairs(self.Subs) do
		local on = s == sub
		Tween(s.Button, 0.2, { BackgroundTransparency = on and 0.8 or 1, TextColor3 = on and WHITE or GRAY })
	end
	if self.Window.CurrentTab == self then
		RefreshTab(self, true)
	end
end

function Page:SelectMain()
	self.ActivePage = self
	for _, s in ipairs(self.Subs) do
		Tween(s.Button, 0.2, { BackgroundTransparency = 1, TextColor3 = GRAY })
	end
	if self.Window.CurrentTab == self then
		RefreshTab(self, true)
	end
end

