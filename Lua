	local window = self.Window
	local items = {}
	for _, opt in ipairs(cfg.Options or {}) do
		if type(opt) == "table" then
			table.insert(items, { Name = opt.Name or tostring(opt[1]), Icon = opt.Icon, Callback = opt.Callback })
		else
			table.insert(items, { Name = tostring(opt) })
		end
