				Font = Enum.Font.GothamBold,
				TextSize = 16,
				TextColor3 = WHITE,
				ZIndex = 7,
				Parent = b,
			})
		end
		return b
	end

	local hideBtn = TopButton(1, HIDE_ICON, "_")
	local halfBtn = TopButton(2, HALF_ICON, "-")
	local deleteBtn = TopButton(3, DELETE_ICON, "X")

	-- Sidebar (tabs) and content area
	local sidebar = Create("ScrollingFrame", {
		Name = "Sidebar",
		Position = UDim2.fromOffset(0, TOP_HEIGHT),
		Size = UDim2.new(0, SIDEBAR_WIDTH, 1, -TOP_HEIGHT),
		BackgroundColor3 = Color3.fromRGB(8, 8, 8),
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = frame,
	})
	Create("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		Parent = sidebar,
	})
	Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = sidebar })
	self.Sidebar = sidebar

	local content = Create("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(SIDEBAR_WIDTH, TOP_HEIGHT),
		Size = UDim2.new(1, -SIDEBAR_WIDTH, 1, -TOP_HEIGHT),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = frame,
	})
	self.Content = content

	-- Dragging: one finger/mouse only, other touches ignored, heavy movement
	local dragInput, dragStart, startPos, current, target
	local HEAVINESS = 0.55
	if draggable then
		topbar.InputBegan:Connect(function(input)
			if dragInput or not IsPress(input) then
				return
			end
			dragInput = input
			dragStart = input.Position
			startPos = frame.AbsolutePosition
			current = startPos
			target = startPos
			Tween(edgeStroke, 0.2, { Transparency = 0.1 })
		end)
		UserInputService.InputChanged:Connect(function(input)
			if not dragInput or not dragStart then
				return
			end
			if input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement) then
				local d = input.Position - dragStart
				target = startPos + Vector2.new(d.X, d.Y) * HEAVINESS
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if dragInput and (input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
				dragInput = nil
				dragStart = nil
				Tween(edgeStroke, 0.3, { Transparency = edgeT })
			end
		end)
		RunService.RenderStepped:Connect(function(dt)
			if target and current and (current - target).Magnitude > 0.1 then
				current = current:Lerp(target, 1 - math.exp(-dt * 12))
				frame.Position = UDim2.fromOffset(current.X, current.Y)
			end
		end)
	end

	-- Open button (shown when the window is hidden)
	local ob = cfg.OpenButton or {}
	local openBtn = Create("TextButton", {
		Name = "OpenButton",
		Size = ob.Size or UDim2.fromOffset(50, 50),
		Position = ob.Position or UDim2.new(0, 20, 0.5, -25),
		BackgroundColor3 = BLACK,
		BackgroundTransparency = ob.Transparency or 0,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ClipsDescendants = true,
		Visible = false,
		Parent = gui,
	})
	Corner(openBtn, 8)
	Stroke(openBtn, 0.3, 1, accent)
	local obImg = ResolveIcon(ob.Icon)
	if obImg then
		Create("ImageLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.6, 0.6),
			Image = obImg,
			ImageColor3 = WHITE,
			Parent = openBtn,
		})
	else
		Create("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Text = (cfg.Name or "W"):sub(1, 1),
			Font = Enum.Font.GothamBold,
			TextSize = 20,
			TextColor3 = WHITE,
			Parent = openBtn,
		})
	end
	BindPress(openBtn, function()
		self:Show()
	end)
	self.OpenBtn = openBtn

	BindPress(hideBtn, function()
		self:Hide()
	end)
	BindPress(halfBtn, function()
		self:SetHalf(not self.Half)
	end)
	BindPress(deleteBtn, function()
		self:AskDelete()
	end)

	-- Welcome screen first, then the window appears
	self.Frame.Visible = false
	if cfg.Welcome ~= false then
		ShowWelcome(type(cfg.Welcome) == "table" and cfg.Welcome or {})
	end
	self:Show()
	return self
end

return Library
